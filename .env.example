# Gemini API Key
GEMINI_API_KEY=

# Fal.ai Configuration
FAL_KEY=

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal Configuration
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=
PAYPAL_WEBHOOK_ID=

# Cloudflare API Configuration (for Workers AI or management)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare R2 Storage (S3-Compatible Storage)
# Set CLOUDFLARE_R2_ENDPOINT to: https://<your_account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=

# Redis / Upstash Cache and Collaboration
# Enter your Upstash TCP URL here, e.g., rediss://default:...@talented-loon-78719.upstash.io:6379
REDIS_URL=
UPSTASH_REDIS_URL=

# Upstash REST credentials (for REST API use if needed)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenRouter API Configuration
OPENROUTER_API_KEY=


